import 'shop.dart';

/// Read-only product discovery. IDs, inventory and historical documents are
/// never changed by a suggestion. No network service or paid AI is required.
class ProductDiscovery {
  const ProductDiscovery._();

  static String normalize(String value) => ShopData.normalizeProductText(value);

  /// Use the same key for 60x60, 60 x 60 and 60×60 (including decimal sizes).
  static String normalizeSpecification(String value) => normalize(
    value.replaceAllMapped(
      RegExp(r'(\d)\s*[xX×]\s*(\d)'),
      (match) => '${match[1]}x${match[2]}',
    ),
  );

  static String displaySpecification(String value) => value.trim().replaceAllMapped(
    RegExp(r'(\d)\s*[xX×]\s*(\d)'),
    (match) => '${match[1]}×${match[2]}',
  ).replaceAllMapped(
    RegExp(r'(\d)\s*(kg|g|mm|cm|ml|lit|l)\b', caseSensitive: false),
    (match) => '${match[1]} ${match[2]!.toLowerCase()}',
  );

  /// A category *suggestion*, not authoritative product metadata. Do not
  /// silently persist it or use it as a reason to merge product identities.
  static String suggestedCategory(Product product) {
    final text = normalize('${product.name} ${product.note}');
    final spec = normalizeSpecification(product.size);
    if (text.contains('keo dan gach') || text.contains('keo cha ron') ||
        text.contains('vua kho') || text.contains('vua xay') ||
        text.contains('keo op lat')) {
      return 'Keo và vữa';
    }
    if (text.contains('xi mang')) return 'Xi măng';
    if (text.contains('sat ') || text.startsWith('sat ') ||
        text.contains('thep') || text.contains('ton ')) {
      return 'Sắt thép và kim loại';
    }
    if (text.contains('ong nuoc') || text.contains('ong pvc') ||
        text.contains('van nuoc') || text.contains('voi nuoc') ||
        text.contains('phu kien nuoc')) {
      return 'Ống và phụ kiện nước';
    }
    if (text.contains('day dien') || text.contains('cong tac') ||
        text.contains('o cam') || text.contains('bong den')) {
      return 'Thiết bị điện';
    }
    if (text.contains('gach') ||
        (product.unit == 'm²' && RegExp(r'^\d+(?:[.,]\d+)?x\d+').hasMatch(spec))) {
      return 'Gạch ốp lát';
    }
    return 'Khác / chưa phân loại';
  }

  static bool hasText(Product product, String query) {
    final needle = normalizeSpecification(query);
    if (needle.isEmpty) return true;
    final searchable = normalizeSpecification(
      '${product.code} ${product.name} ${product.size} '
      '${product.supplier} ${product.unit} ${product.note}',
    );
    if (searchable.contains(needle)) return true;
    final words = needle.split(' ').where((word) => word.isNotEmpty);
    if (words.every(searchable.contains)) return true;
    // Typographical suggestions, not automatic identity matching.
    return needle.length >= 5 &&
        _editDistanceAtMost(normalize(product.name), needle, 2);
  }

  static bool sameSpecification(String a, String b) =>
      normalizeSpecification(a) == normalizeSpecification(b);

  static List<ProductSuggestion> suggest({
    required Iterable<Product> products,
    required String name,
    required String code,
    required String specification,
    required String unit,
    required String supplier,
    String excludeId = '',
    int limit = 5,
  }) {
    final requestedName = normalize(name);
    final requestedCode = normalize(code);
    final requestedSize = normalizeSpecification(specification);
    final requestedUnit = normalize(unit);
    final requestedSupplier = normalize(supplier);
    if (requestedName.length < 3 && requestedCode.length < 3) return [];
    final result = <ProductSuggestion>[];
    for (final product in products) {
      if (product.id == excludeId) continue;
      final oldName = normalize(product.name);
      final oldCode = normalize(product.code);
      final exactCode = requestedCode.isNotEmpty && requestedCode == oldCode;
      final exactName = requestedName.isNotEmpty && requestedName == oldName;
      final closeName = !exactName && requestedName.length >= 5 &&
          (oldName.contains(requestedName) ||
              requestedName.contains(oldName) ||
              _editDistanceAtMost(oldName, requestedName, 2));
      final tokens = requestedName.split(' ').where((word) => word.length >= 3).toSet();
      final common = tokens.intersection(oldName.split(' ').toSet()).length;
      final sharedWords = tokens.length >= 2 && common >= 2;
      if (!exactCode && !exactName && !closeName && !sharedWords) continue;

      final sameSize = requestedSize.isNotEmpty &&
          requestedSize == normalizeSpecification(product.size);
      final sameUnit = requestedUnit.isNotEmpty &&
          requestedUnit == normalize(product.unit);
      final sameSupplier = requestedSupplier.isNotEmpty &&
          requestedSupplier == normalize(product.supplier);
      final completelyMatched = exactName && sameSize && sameUnit;
      final score = (exactCode ? 110 : 0) + (exactName ? 80 : 0) +
          (closeName ? 55 : 0) + (sharedWords ? 35 : 0) +
          (sameSize ? 12 : 0) + (sameUnit ? 8 : 0) +
          (sameSupplier ? 5 : 0);
      result.add(ProductSuggestion(
        product: product,
        score: score,
        exactName: exactName,
        sameSpecification: sameSize,
        sameUnit: sameUnit,
        exactCode: exactCode,
        likelyDuplicate: completelyMatched || exactCode,
      ));
    }
    result.sort((a, b) {
      final compared = b.score.compareTo(a.score);
      return compared != 0 ? compared : a.product.code.compareTo(b.product.code);
    });
    return result.take(limit).toList();
  }

  static bool _editDistanceAtMost(String a, String b, int maxDistance) {
    if ((a.length - b.length).abs() > maxDistance ||
        a.length > 100 || b.length > 100) return false;
    if (a == b) return true;
    var previous = List<int>.generate(b.length + 1, (i) => i);
    for (var i = 0; i < a.length; i++) {
      final current = List<int>.filled(b.length + 1, 0);
      current[0] = i + 1;
      var rowMinimum = current[0];
      for (var j = 0; j < b.length; j++) {
        final substitution = a.codeUnitAt(i) == b.codeUnitAt(j) ? 0 : 1;
        final deletion = previous[j + 1] + 1;
        final insertion = current[j] + 1;
        final replace = previous[j] + substitution;
        var best = deletion < insertion ? deletion : insertion;
        if (replace < best) best = replace;
        current[j + 1] = best;
        if (best < rowMinimum) rowMinimum = best;
      }
      if (rowMinimum > maxDistance) return false;
      previous = current;
    }
    return previous.last <= maxDistance;
  }
}

class ProductSuggestion {
  final Product product;
  final int score;
  final bool exactName;
  final bool sameSpecification;
  final bool sameUnit;
  final bool exactCode;
  final bool likelyDuplicate;

  const ProductSuggestion({
    required this.product,
    required this.score,
    required this.exactName,
    required this.sameSpecification,
    required this.sameUnit,
    required this.exactCode,
    required this.likelyDuplicate,
  });

  String get explanation {
    if (exactCode) return 'Mã SKU trùng — cần kiểm tra';
    if (likelyDuplicate) return 'Tên, quy cách và đơn vị trùng';
    if (exactName && !sameSpecification) return 'Trùng tên, cần so quy cách';
    if (exactName) return 'Trùng tên, cần so đơn vị';
    return 'Tên gần giống — cần đối chiếu';
  }
}
