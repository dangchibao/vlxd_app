{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/offline-@(sw|manifest).js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/sqlite3.wasm",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "vlxd-bay-hai",
          "appId": "1:6280664958:android:014e50ff389f9922a0c52f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "vlxd-bay-hai",
          "configurations": {
            "android": "1:6280664958:android:014e50ff389f9922a0c52f",
            "ios": "1:6280664958:ios:4ca6745afc63c316a0c52f",
            "macos": "1:6280664958:ios:4ca6745afc63c316a0c52f",
            "web": "1:6280664958:web:66c8e00bd1ce63d6a0c52f",
            "windows": "1:6280664958:web:71b4727984aee220a0c52f"
          }
        }
      }
    }
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    }
  }
}
